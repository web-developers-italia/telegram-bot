{
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2023",
		"lib": ["ES2023"],
		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "lib",
		"rootDir": "src"
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts", "src/test"]
}
