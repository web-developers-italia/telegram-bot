// Esempio per chi vuole aggiungere un nuovo comando al bot.
// Questo file NON viene compilato (estensione .ts.example): copialo, rinominalo
// in `<nomecomando>.ts` e aggiungilo all'array `commands` in `index.ts`.

// ---------------------------------------------------------------------------
// Caso 1: comando "statico", cioè che risponde sempre con lo stesso testo
// (eventualmente formattato). È il caso più comune, non richiede di conoscere
// Effect.
// ---------------------------------------------------------------------------

// import { staticCommand } from "../CommandsProtocol.js";
//
// export const esempio = staticCommand(["/esempio"], "Testo di risposta fisso.");
//
// // Con formattazione (grassetti, link, ...) tramite @grammyjs/parse-mode:
// import { FormattedString } from "@grammyjs/parse-mode";
//
// export const esempioFormattato = staticCommand(
// 	["/esempio2"],
// 	FormattedString.bold("Testo in grassetto"),
// );
//
// // { preferRepliedMessage: true } fa sì che, se il comando viene usato in
// // reply a un messaggio, la risposta punti al messaggio quotato invece che
// // al comando stesso (utile per /learn, /dontasktoask, ecc.).
// export const esempioInReply = staticCommand(["/esempio3"], "Testo...", {
// 	preferRepliedMessage: true,
// });

